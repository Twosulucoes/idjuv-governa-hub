# Agendamento do backup do Supabase self-hosted (scripts/backup/backup-vps.sh). Guia: docs/BACKUP.md.
# Instalar na VPS (como root):  install -m 644 scripts/backup/idjuv-backup.cron /etc/cron.d/idjuv-backup
# O cron usa o fuso da VPS (confira com `date`); com America/Boa_Vista, 03:30 locais = 07:30 UTC.
# O "Vigia do backup" (.github/workflows/backup-vigia.yml) confere todo dia às 08:00 locais que o backup chegou.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# O marcador .ultimo-ok (epoch do último backup bem-sucedido) é lido pelo /root/stack-health.sh.
# Em cron o % precisa de \% (sem isso o comando é cortado e o marcador nunca é gravado).
30 3 * * * root /usr/local/bin/idjuv-backup >> /var/log/idjuv-backup.log 2>&1 && date -u +\%s > /var/backups/idjuv/.ultimo-ok
# Pacote de segredos (.env do Supabase, chave do pgsodium, rotas do Traefik), cifrado, para o bucket separado.
# Domingo 03:50 (depois do backup do banco). Só funciona com BACKUP_SEGREDOS_REMOTE preenchido; o vigia cobre o banco.
50 3 * * 0 root /usr/local/bin/idjuv-backup-segredos >> /var/log/idjuv-backup-segredos.log 2>&1
