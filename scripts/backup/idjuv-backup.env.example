# Copie para /etc/idjuv-backup.env na VPS (chmod 600) e ajuste. Guia: docs/BACKUP.md.

# Container do Postgres do Supabase self-hosted (docker ps --format '{{.Names}}' | grep db)
BACKUP_DB_CONTAINER=supabase-db

# Pasta dos arquivos do Storage no host (no docker-compose oficial: <pasta do supabase>/docker/volumes/storage)
BACKUP_STORAGE_DIR=/root/supabase/docker/volumes/storage

# Chave PÚBLICA do age (a privada NÃO fica na VPS). Gere com: age-keygen -o idjuv-backup.key
BACKUP_AGE_RECIPIENT=age1...

# Remoto do rclone (configurado com `rclone config`) + bucket/pasta. Ex.: Cloudflare R2 ou Backblaze B2.
BACKUP_RCLONE_REMOTE=r2:idjuv-backups

# Opcional: URL de ping do healthchecks.io (gratuito) — avisa por e-mail se o backup falhar ou não rodar.
BACKUP_HEALTHCHECK_URL=

# Retenção (formato do rclone: 8d, 36d, 400d)
BACKUP_RETER_DIARIO=8d
BACKUP_RETER_SEMANAL=36d
BACKUP_RETER_MENSAL=400d
